# Tool execution only: no backend, Node runtime, credentials or Docker socket.
FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    DATAAGENT_PYTHON_BIN=/usr/local/bin/python SKILLS_ROOT_DIR=/opt/skills \
    HOME=/tmp \
    # Runtime `pip install` (needs DATAAGENT_SANDBOX_NETWORK) falls back to a user
    # install. Keep it in the topic workspace so it survives across execution
    # segments of the session; /tmp is per container and 256 MB.
    PYTHONUSERBASE=/mnt/workspace/.dataagent/python \
    PATH=/mnt/workspace/.dataagent/python/bin:$PATH \
    PIP_CACHE_DIR=/tmp/pip-cache PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash jq ripgrep fd-find sqlite3 \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*
COPY dataagent-backend/requirements-sandbox.txt /tmp/requirements-sandbox.txt
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir -r /tmp/requirements-sandbox.txt \
    && mkdir -p /mnt/workspace /mnt/results /opt/skills
WORKDIR /mnt/workspace
USER 1000:1000
CMD ["sleep", "1800"]
