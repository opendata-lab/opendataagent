MYSQL_ROOT_PASSWORD=root123
DATAAGENT_MYSQL_PASSWORD=dataagent123
DATAAGENT_SESSION_MYSQL_DATABASE=dataagent
DATAAGENT_HOST_ROOT=/dataagent_runtime
DATAAGENT_RUNTIME_UID=1000
DATAAGENT_RUNTIME_GID=1000
DATAAGENT_DOCKER_SOCKET=/var/run/docker.sock

# 以下仅在偏离默认部署时启用。
# 默认 Pi；确需切换旧引擎时启用：
# DATAAGENT_RUNTIME_KIND=claude_code
# 日志收集目标容器（空格分隔）：
# LOG_COLLECTOR_CONTAINERS=dataagent-backend dataagent-sandbox-runner

# 可选镜像覆盖；离线打包脚本自动填入实际 tag。
# ODA_FRONTEND_IMAGE=oda-frontend:latest
# ODA_BACKEND_IMAGE=oda-backend:latest
# ODA_RUNNER_IMAGE=oda-runner:latest
# LOG_COLLECTOR_IMAGE=docker:27.5.1-cli
