# ---- 数据库配置（自备 MySQL / RDS 数据库实例）----
# 库和用户需先建好：用 root 执行 deploy/database/mysql/01-init-database.sql（见 deploy/README.md）。
# MYSQL_HOST 必须是 backend 容器能访问的地址，127.0.0.1 指容器自己，不是宿主机。
# 数据库在 Docker 宿主机上时，Linux 填宿主机 IP，macOS/Windows 可填 host.docker.internal。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dataagent
MYSQL_PASSWORD=dataagent123
MYSQL_DATABASE=dataagent

# ---- 运行时目录与 Docker Socket ----
DATAAGENT_HOST_ROOT=/dataagent_runtime
DATAAGENT_RUNTIME_UID=1000
DATAAGENT_RUNTIME_GID=1000
DATAAGENT_DOCKER_SOCKET=/var/run/docker.sock

# 以下仅在偏离默认部署时启用。
# 运行时固定为 Pi；执行工具使用 oda-sandbox 镜像。
# 可选镜像覆盖；离线打包脚本自动填入实际 tag。
# ODA_FRONTEND_IMAGE=oda-frontend:latest
# ODA_BACKEND_IMAGE=oda-backend:latest
# ODA_SANDBOX_IMAGE=oda-sandbox:latest
# 每个执行段沙箱容器的资源上限（内存同时作为 swap 上限）。
# DATAAGENT_SANDBOX_MEMORY=2g
# DATAAGENT_SANDBOX_CPUS=2
# DATAAGENT_SANDBOX_PIDS_LIMIT=512
# 沙箱网络。默认 none（断网）；可信环境中技能需要访问内部服务时设为 bridge 或自建网络名。
# DATAAGENT_SANDBOX_NETWORK=none
# 沙箱运行时 pip install 使用的包索引（构建参数 PIP_INDEX_URL 只在构建镜像时生效）。访问不到 PyPI 的网络填内网镜像。
# DATAAGENT_SANDBOX_PIP_INDEX_URL=
# DATAAGENT_SANDBOX_PIP_TRUSTED_HOST=
