"""DataAgent 外置配置用户覆盖示例（Superset superset_config_docker.py 同款机制）。

拷贝本文件为同目录下的 `dataagent_config_docker.py`（已被 .gitignore 忽略，
不会入库），按需修改后重启 dataagent-backend 即生效。本目录在容器内位于
`sys.path` 上，你也可以在同目录放自定义模块并在这里 import
（示例见 custom_sso_user_info.py.example）。

注意：
- DataAgent 统一账号体系始终启用登录认证（不再支持 AUTH_ENABLED = False）。
- 用户、密码哈希、角色与助手授权统一存储在数据库（da_user / da_role / da_agent_grant）。
- 首次部署请使用 CLI 创建初始管理员：
    python -m core.accounts create-user --username admin --password '<strong-pass>' --admin
- 旧版 LOCAL_ADMINS 仅在 Alembic 迁移 20261123_000042 切库时读取一次（ADMIN_USERS 不再导入），
  运行时不会生效。
"""

# ---------------------------------------------------------------------------
# 会话 JWT 密钥（HS256）。必填，替换为不少于 32 字节的随机值：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 保留占位值或过短会导致启动失败（fail-closed）。
# ---------------------------------------------------------------------------
SECRET_KEY = "CHANGE-ME-generate-with-secrets.token_urlsafe(32)"

# ---------------------------------------------------------------------------
# 系统默认初始密码：用于后台新建用户、重置密码及外部可信登录首次自动注册。
# 建议替换为高强度初始密码，并提醒用户在「个人资料」页修改。
# ---------------------------------------------------------------------------
DEFAULT_USER_PASSWORD = ""

# 是否允许 OAuth 或受信任代理 Widget 首次登录时自动创建平台账号。
AUTO_REGISTER_ENABLED = True

# 会话有效期（秒），默认 8 小时。
SESSION_TTL_SECONDS = 28800

# 会话 Cookie。HttpOnly 由代码硬编码，不可配置。HTTPS 入口置 COOKIE_SECURE = True。
COOKIE_NAME = "da_session"
COOKIE_SECURE = False
COOKIE_SAMESITE = "lax"

# ---------------------------------------------------------------------------
# OAuth2 授权码模式（通用 OIDC Provider）。
# 保持下方空列表则登录页只提供本地用户名/密码登录。
# 要启用 OAuth，将下方 provider 模板取消注释并填入真实值。
# ---------------------------------------------------------------------------
OAUTH_PROVIDERS = [
    # {
    #     # Provider 键和登录按钮显示名（1-64 位安全 key，不能使用保留值 local）。
    #     "name": "SSO",
    #     # Font Awesome 4 class，如 fa-github / fa-google；留空则不显示图标。
    #     "icon": "fa-github",
    #     "token_key": "access_token",
    #     "remote_app": {
    #         "client_id": "your-client-id",
    #         "client_secret": "your-client-secret",
    #         "authorize_url": "https://sso.example.com/oauth/authorize",
    #         "access_token_url": "https://sso.example.com/oauth/token",
    #         "api_base_url": "https://sso.example.com/oauth/",
    #         "client_kwargs": {"scope": "openid profile"},
    #         # 必须与 IdP 侧注册的回调一致：
    #         #   https://<dataagent-host>/oauth-authorized/SSO
    #         "redirect_uri": "https://<dataagent-host>/oauth-authorized/SSO",
    #         "response_type": "code",
    #         "grant_type": "authorization_code",
    #     },
    # }
]

# ---------------------------------------------------------------------------
# UserInfo 获取与归一化钩子（OAuth 启用时必填）。
# 仅返回身份和资料字段（sub / username / display_name / email / email_verified），
# 不再由 OAuth 钩子下发 role；角色统一在后台「角色管理 / 用户管理」维护。
#
#   from custom_sso_user_info import oauth_user_info
#   OAUTH_USER_INFO = oauth_user_info
# ---------------------------------------------------------------------------
OAUTH_USER_INFO = None

# 仅当企业 OAuth 的 username 与 DataAgent 本地用户名属于同一命名空间时置 True，
# 允许首次 OAuth 登录按同名普通用户自动归并（绝不自动归并管理员账号）。
OAUTH_TRUSTED_USERNAME_NAMESPACE = False

# ---------------------------------------------------------------------------
# 其他运行时配置覆盖（可选）：键为 dataagent-backend/config.py 中 Settings 的
# 字段名，启动时统一应用；含未知字段会启动失败（fail-closed）。
# ---------------------------------------------------------------------------
DATAAGENT_SETTINGS = {
    # "agent_max_turns": 40,
    # "agent_max_tool_calls": 200,  # Pi
    # "agent_timeout_seconds": 1800,
    # "agent_bash_timeout_seconds": 600,  # Pi
    # "agent_sql_read_timeout_seconds": 300,
    # "agent_sql_write_timeout_seconds": 60,
    # "dataagent_run_idle_timeout_seconds": 300,  # Pi
}
